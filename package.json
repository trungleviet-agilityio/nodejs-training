{
  "name": "nodejs-training",
  "version": "1.0.0",
  "description": "Node.js and TypeScript learning repository",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist node_modules package-lock.json",
    "clean:cache": "npm cache clean --force",
    "clean:modules": "rm -rf node_modules && npm install",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint typescripts-learning/src/**/*.ts",
    "lint:fix": "eslint typescripts-learning/src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "pre-commit": "npm run type-check && npm run lint && npm test"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "learning",
    "training"
  ],
  "author": "Trung Le",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.0.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:trungleviet-agilityio/nodejs-training.git"
  },
  "bugs": {
    "url": "https://github.com/trungleviet-agilityio/nodejs-training/issues"
  },
  "homepage": "https://github.com/trungleviet-agilityio/nodejs-training#readme"
}
